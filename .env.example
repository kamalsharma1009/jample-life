# ============================================================
# Jample Life — Environment Configuration Template
# ============================================================
# For local development: copy this file to `.env.local`
# For Vercel deployment: add these in Project Settings -> Environment Variables
# ============================================================

# Supabase Project URL (found in Supabase Dashboard -> Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anonymous Public Key (safe for client-side frontend)
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# Application Branding
VITE_APP_NAME=Jample Life

# Base URL (optional in production as the app automatically falls back to window.location.origin)
# Local: http://localhost:5174 | Vercel: https://your-domain.vercel.app
VITE_APP_URL=http://localhost:5174
